# LeadPilot - Modele de configuration
# Copier ce fichier en .env et remplir avec vos propres valeurs.

# Base de donnees PostgreSQL
DATABASE_URL=postgresql://leadpilot:secret@localhost:5432/leadpilot_db

# Securite (JWT)
SECRET_KEY=changez_moi_par_une_cle_aleatoire

# Redis (Celery + cache)
REDIS_URL=redis://localhost:6379/0

# Enrichissement : Hunter.io (email finder)
HUNTER_API_KEY=

# Generation de contenu IA
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Envoi d'emails : Brevo
BREVO_API_KEY=
FROM_EMAIL=contact@votredomaine.com
FROM_NAME=LeadPilot

# Scraping : Foursquare (optionnel)
FOURSQUARE_API_KEY=

# URLs (tracking des emails / liens)
APP_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000
